{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$PWD\"; while [ ! -f \"$d/AGENTS.md\" ] && [ \"$d\" != / ]; do d=\"$(dirname \"$d\")\"; done; bash \"$d/.claude/hooks/session-start.sh\" codex",
            "commandWindows": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand "
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*|.*node_repl.*|.*cua_repl.*|.*[Bb]rowser.*|.*[Cc]omputer.*|^Bash$|^shell$|^shell_command$|^exec_command$|^local_shell$|^unified_exec$",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$PWD\"; while [ ! -f \"$d/AGENTS.md\" ] && [ \"$d\" != / ]; do d=\"$(dirname \"$d\")\"; done; bash \"$d/.claude/hooks/guard.sh\" || { echo 'Safety check could not run, so this was blocked to be safe. Tell the user the safety check in .claude/hooks/guard.sh is not working.' >&2; exit 2; }",
            "commandWindows": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand "
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$PWD\"; while [ ! -f \"$d/AGENTS.md\" ] && [ \"$d\" != / ]; do d=\"$(dirname \"$d\")\"; done; bash \"$d/.claude/hooks/after-write.sh\" codex",
            "commandWindows": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand "
          }
        ]
      }
    ]
  }
}

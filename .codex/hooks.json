{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'd=\"$PWD\"; while [ ! -f \"$d/AGENTS.md\" ] && [ \"$d\" != / ]; do d=\"$(dirname \"$d\")\"; done; [ -f \"$d/.claude/hooks/session-start.sh\" ] || exit 0; bash \"$d/.claude/hooks/session-start.sh\" codex'",
            "timeout": 30,
            "statusMessage": "Loading your job search",
            "commandWindows": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand "
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*|.*node_repl.*|.*cua_repl.*|.*[Bb]rowser.*|.*[Cc]omputer.*|^Bash$|^shell$|^shell_command$|^exec_command$|^local_shell$|^unified_exec$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'd=\"$PWD\"; while [ ! -f \"$d/AGENTS.md\" ] && [ \"$d\" != / ]; do d=\"$(dirname \"$d\")\"; done; bash \"$d/.claude/hooks/guard.sh\" codex; c=$?; if [ \"$c\" -ne 0 ] && [ \"$c\" -ne 2 ]; then echo \"Safety check could not run, so this was blocked to be safe. Tell the user the safety check in .claude/hooks/guard.sh is not working.\" >&2; c=2; fi; exit \"$c\"'",
            "timeout": 30,
            "statusMessage": "Running the safety check",
            "commandWindows": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand "
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'd=\"$PWD\"; while [ ! -f \"$d/AGENTS.md\" ] && [ \"$d\" != / ]; do d=\"$(dirname \"$d\")\"; done; [ -f \"$d/.claude/hooks/after-write.sh\" ] || exit 0; bash \"$d/.claude/hooks/after-write.sh\" codex'",
            "timeout": 15,
            "commandWindows": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand "
          }
        ]
      }
    ]
  }
}

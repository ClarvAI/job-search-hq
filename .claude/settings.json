{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Skill",
      "mcp__interview-room",
      "Bash(ls *)",
      "Bash(date *)",
      "Bash(unzip -n imports/*.zip -d imports/*)",
      "Bash(bash .claude/hooks/summary.sh *)",
      "Bash(bash .claude/skills/health/scripts/health.sh *)",
      "Bash(bash .claude/skills/start/scripts/init-data.sh)",
      "Bash(bash .claude/skills/start/scripts/init-data.sh *)",
      "Bash(bash .claude/skills/update/scripts/update.sh --status)",
      "Bash(bash .claude/skills/update/scripts/update.sh --check)",
      "Bash(bash .claude/skills/update/scripts/update.sh --check *)",
      "Bash(bash .claude/skills/tailor-resume/scripts/page-count.sh *)",
      "Bash(bash .claude/skills/tailor-resume/scripts/make-pdf.sh jobs/*)",
      "Bash(say *)",
      "Bash(mv outbox/*.md outbox/sent/)",
      "Bash(mv outbox/*.md outbox/discarded/)"
    ],
    "ask": [
      "Edit(profile/master-resume.md)",
      "Edit(profile/preferences.md)",
      "Edit(.codex/**)",
      "Edit(.githooks/**)",
      "Edit(.agents/**)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(VERSION)",
      "Edit(product-manifest.json)",
      "Edit(migrations/**)",
      "Bash(bash .claude/skills/update/scripts/update.sh *--rollback*)",
      "Bash(mv *.codex*)",
      "Bash(mv *.githooks*)",
      "Bash(mv *.agents*)",
      "Bash(mv *AGENTS.md*)",
      "Bash(mv *CLAUDE.md*)",
      "Bash(mv *templates/*)",
      "Bash(mv *VERSION*)",
      "Bash(mv *product-manifest.json*)",
      "Bash(rm *.codex*)",
      "Bash(rm *.githooks*)",
      "Bash(rm *.agents*)",
      "Bash(rm *AGENTS.md*)",
      "Bash(rm *CLAUDE.md*)",
      "Bash(rm *templates/*)",
      "Bash(rm *VERSION*)",
      "Bash(rm *product-manifest.json*)",
      "Bash(sed *.codex*)",
      "Bash(sed *.githooks*)",
      "Bash(sed *.agents*)",
      "Bash(sed *AGENTS.md*)",
      "Bash(sed *CLAUDE.md*)",
      "Bash(sed *templates/*)",
      "Bash(sed *VERSION*)",
      "Bash(sed *product-manifest.json*)",
      "Bash(cp * *.codex*)",
      "Bash(cp * *.githooks*)",
      "Bash(cp * *.agents*)",
      "Bash(cp * *AGENTS.md*)",
      "Bash(cp * *CLAUDE.md*)",
      "Bash(cp * *templates/*)",
      "Bash(cp * *VERSION*)",
      "Bash(cp * *product-manifest.json*)",
      "Bash(unzip *..*)",
      "Bash(unzip * -o*)",
      "Bash(unzip *-:*)",
      "Bash(unzip *.claude*)",
      "Bash(unzip *.codex*)",
      "Bash(unzip *.githooks*)",
      "Bash(unzip *.agents*)",
      "Bash(unzip *templates/*)",
      "Bash(say -o*)",
      "Bash(say * -o*)",
      "Bash(say *--output-file*)",
      "Bash(say -n*)",
      "Bash(say * -n*)",
      "Bash(say *--network-send*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*|WebFetch|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\" || { echo 'Safety check could not run, so this was blocked to be safe. Tell the user the safety check in .claude/hooks/guard.sh is not working.' >&2; exit 2; }",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-write.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/statusline.sh\""
  },
  "companyAnnouncements": [
    "Welcome to your Job Search HQ. First time? Type /start. Every day: /today. Lost? /menu."
  ]
}

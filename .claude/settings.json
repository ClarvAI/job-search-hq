      "Bash(mv *.codex*)",
      "Bash(mv *.githooks*)",
      "Bash(mv *.agents*)",
      "Bash(mv *AGENTS.md*)",
      "Bash(mv *CLAUDE.md*)",
      "Bash(mv *templates/*)",
      "Bash(mv *VERSION*)",
      "Bash(mv *product-manifest.json*)",

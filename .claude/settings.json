      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File .claude\\skills\\update\\scripts\\update.ps1 -Check)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File .claude\\skills\\update\\scripts\\update.ps1 -Check *)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File .claude\\skills\\update\\scripts\\update.ps1 -Check *)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File .claude\\skills\\start\\scripts\\init-data.ps1)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File .claude\\skills\\start\\scripts\\init-data.ps1)",

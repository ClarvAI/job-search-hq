      "Bash(rm *.githooks*)",
      "Bash(rm *.agents*)",
      "Bash(rm *AGENTS.md*)",
      "Bash(rm *CLAUDE.md*)",
      "Bash(rm *templates/*)",
      "Bash(rm *VERSION*)",
      "Bash(rm *product-manifest.json*)",
      "Bash(sed *.codex*)",
      "Bash(sed *.githooks*)",
      "Bash(sed *.agents*)",
      "Bash(sed *AGENTS.md*)",
      "Bash(sed *CLAUDE.md*)",
      "Bash(sed *templates/*)",
      "Bash(sed *VERSION*)",
      "Bash(sed *product-manifest.json*)",
      "Bash(cp * *.codex*)",
      "Bash(cp * *.githooks*)",
      "Bash(cp * *.agents*)",
      "Bash(cp * *AGENTS.md*)",
      "Bash(cp * *CLAUDE.md*)",
      "Bash(cp * *templates/*)",
      "Bash(cp * *VERSION*)",
      "Bash(cp * *product-manifest.json*)",
      "Bash(*preferences.md*)",
      "Bash(*master-resume.md*)",
      "Bash(*>*profile/*)",
      "Bash(cp *profile/*)",
      "Bash(mv *profile/*)",
      "Bash(rm *profile/*)",
      "Bash(tee *profile/*)",
      "Bash(sed *profile/*)",
      "Bash(awk *profile/*)",
      "Bash(perl *profile/*)",
      "Bash(python* *profile/*)",
      "Bash(node *profile/*)",
      "Bash(ruby *profile/*)",
      "Bash(dd *profile/*)",
      "Bash(touch *profile/*)",
      "Bash(truncate *profile/*)",
      "Bash(ln *profile/*)",
      "Bash(install *profile/*)",
      "Bash(rsync *profile/*)",
      "Bash(ditto *profile/*)",
      "Bash(tar *profile*)",
      "Bash(unzip *profile*)",
      "PowerShell(Set-Content *profile*)",
      "PowerShell(Add-Content *profile*)",
      "PowerShell(Out-File *profile*)",
      "PowerShell(Copy-Item *profile*)",
      "PowerShell(Move-Item *profile*)",
      "PowerShell(Remove-Item *profile*)",
      "PowerShell(Rename-Item *profile*)",
      "PowerShell(New-Item *profile*)",
      "PowerShell(Clear-Content *profile*)",
      "PowerShell(Expand-Archive *profile*)",
      "PowerShell(cp *profile*)",
      "PowerShell(copy *profile*)",
      "PowerShell(mv *profile*)",
      "PowerShell(move *profile*)",
      "PowerShell(rm *profile*)",
      "PowerShell(del *profile*)",
      "PowerShell(ren *profile*)",
      "PowerShell(*>*profile*)",
      "Bash(gh gist create*)",
      "Bash(unzip *..*)",
      "Bash(unzip * -o*)",
      "Bash(unzip *: *)",
      "Bash(unzip *.claude*)",
      "Bash(unzip *.codex*)",
      "Bash(unzip *.githooks*)",
      "Bash(unzip *.agents*)",
      "Bash(unzip *templates/*)",
      "Bash(say -o*)",
      "Bash(say * -o*)",
      "Bash(say *--output-file*)",
      "Bash(say -n*)",
      "Bash(say * -n*)",
